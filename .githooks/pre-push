#!/usr/bin/env bash
# Reject secrets/PII before any branch reaches a public remote. Installed with
# ./tools/install-git-hooks.sh; CI repeats the same check after push.
set -euo pipefail

remote_name="$1"
remote_url="$2"
empty_tree=$(git hash-object -t tree /dev/null)
failed=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # Deleting a ref contains an all-zero local SHA and adds no source.
  [[ "$local_sha" != "0000000000000000000000000000000000000000" ]] || continue
  case "$remote_ref" in
    refs/heads/*) ;;
    *) continue ;;
  esac

  # A newly published branch has no remote base. Scan its full tree; later
  # pushes scan only additions since the remote tip.
  base="$remote_sha"
  [[ "$base" != "0000000000000000000000000000000000000000" ]] || base="$empty_tree"
  echo "PII pre-push: $local_ref -> $remote_ref ($remote_name)" >&2
  if ! ./tools/check-pii.sh --range "$base" "$local_sha"; then
    failed=1
  fi
done

if [[ "$failed" -ne 0 ]]; then
  echo "Push rejected by the local PII guard. Remove the data, use a placeholder, then retry." >&2
  exit 1
fi
